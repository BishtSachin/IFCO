@page "/users"
@rendermode InteractiveServer
@using IFCO.WEB.Models
@using IFCO.WEB.Services
@inject OracleService DbService
@inject IJSRuntime JSRuntime
@attribute [Authorize(Roles = "Admin")]

<PageTitle>User Master</PageTitle>

<div class="card shadow-sm">
    <div class="card-header d-flex justify-content-between align-items-center">
        <h5 class="mb-0"><i class="bi bi-people-fill me-2"></i>Existing Users</h5>
        <button class="btn btn-primary" @onclick="() => OpenModal(null)">
            <i class="bi bi-person-plus-fill me-2"></i>Add New User
        </button>
    </div>
    <div class="card-body">
        @if (users == null)
        {
            <div class="text-center p-4">
                <div class="spinner-border text-primary" role="status">
                    <span class="visually-hidden">Loading...</span>
                </div>
                <p class="mt-2">Loading Users...</p>
            </div>
        }
        else
        {
            <div class="table-responsive">
                <table class="table table-striped table-hover">
                    <thead class="table-dark">
                        <tr>
                            <th>User ID</th>
                            <th>User Name</th>
                            <th>Type</th>
                            <th>Assigned Vertical</th>
                            <th>Status</th>
                            <th>Actions</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var user in users)
                        {
                            <tr>
                                <td>@user.UserId</td>
                                <td>@user.UserName</td>
                                <td>@user.UserType</td>
                                <td>@user.VerticalName</td>
                                <td>
                                    <span class="badge @(user.Status == "Active" ? "bg-success" : "bg-danger")">
                                        @user.Status
                                    </span>
                                </td>
                                <td>
                                    <button class="btn btn-sm btn-outline-secondary" @onclick="() => OpenModal(user)">
                                        <i class="bi bi-pencil-square"></i> Edit
                                    </button>
                                    @if (user.Status == "Active")
                                    {
                                        <button class="btn btn-sm btn-warning ms-2" @onclick="() => ToggleStatusAsync(user)">
                                            <i class="bi bi-toggle-off"></i> Deactivate
                                        </button>
                                    }
                                    else
                                    {
                                        <button class="btn btn-sm btn-success ms-2" @onclick="() => ToggleStatusAsync(user)">
                                            <i class="bi bi-toggle-on"></i> Activate
                                        </button>
                                    }
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
            <div class="mt-4">
                <Pagination CurrentPage="@currentPage" TotalPages="@totalPages" OnPageChanged="OnPageChanged" />
            </div>
        }
    </div>
</div>

<Modal Title="@modalTitle" @bind-IsOpen="isModalVisible">
    <Body>
        @if (userInModal != null)
        {
            <EditForm @ref="modalForm" Model="@userInModal" OnValidSubmit="HandleSubmit">
                <DataAnnotationsValidator />
                <div class="row">
                    <div class="col-md-6 mb-3">
                        <label class="form-label">User ID</label>
                        <InputText @bind-Value="userInModal.UserId" class="form-control" disabled="@(!isAddingNew)" />
                        <ValidationMessage For="@(() => userInModal.UserId)" />
                    </div>
                    <div class="col-md-6 mb-3">
                        <label class="form-label">User Name</label>
                        <InputText @bind-Value="userInModal.UserName" class="form-control" />
                        <ValidationMessage For="@(() => userInModal.UserName)" />
                    </div>
                </div>
                <div class="row">
                    <div class="col-md-6 mb-3">
                        <label class="form-label">User Type</label>
                        <InputSelect @bind-Value="userInModal.UserType" class="form-select">
                            <option value="Vertical">Vertical</option>
                            <option value="Admin">Admin</option>
                        </InputSelect>
                    </div>
                    <div class="col-md-6 mb-3">
                        <label class="form-label">Assign to Vertical</label>
                        <InputSelect @bind-Value="userInModal.VerticalId" class="form-select" disabled="@(userInModal.UserType == "Admin")">
                            <option value="">-- Select Vertical --</option>
                            @if (verticalsForDropdown != null)
                            {
                                @foreach (var vertical in verticalsForDropdown)
                                {
                                    <option value="@vertical.VerticalId">@vertical.VerticalName</option>
                                }
                            }
                        </InputSelect>
                    </div>
                </div>
            </EditForm>
        }
    </Body>
    <Footer>
        <button type="button" class="btn btn-secondary" @onclick="CloseModal">Cancel</button>
        <button type="button" class="btn btn-primary" @onclick="TriggerSubmit">Save Changes</button>
    </Footer>
</Modal>

@code {
    [CascadingParameter]
    private Task<AuthenticationState> AuthenticationStateTask { get; set; }
    private string? currentUserId;

    private List<VerticalUserMaster>? users;
    private List<VerticalMaster>? verticalsForDropdown;

    private int currentPage = 1;
    private int pageSize = 10;
    private int totalRecords = 0;
    private int totalPages => (int)Math.Ceiling(totalRecords / (double)pageSize);

    private bool isModalVisible = false;
    private bool isAddingNew;
    private string modalTitle = "";
    private VerticalUserMaster userInModal = new();
    private EditForm? modalForm;

    protected override async Task OnInitializedAsync()
    {
        var authState = await AuthenticationStateTask;
        currentUserId = authState.User.Identity?.Name ?? "UNKNOWN";
        await Task.WhenAll(
            LoadUsers(currentPage),
            LoadDropdownData()
        );
    }

    private async Task LoadUsers(int pageNumber = 1)
    {
        users = null;
        var result = await DbService.SearchUsersAsync(pageNumber: pageNumber, pageSize: pageSize);
        users = result.Users;
        totalRecords = result.TotalRecords;
        currentPage = pageNumber;
    }

    private async Task LoadDropdownData()
    {
        verticalsForDropdown = await DbService.GetVerticalsAsync();
    }

    private async Task OnPageChanged(int newPage)
    {
        await Task.WhenAll(
            LoadUsers(newPage),
            LoadDropdownData()
        );
    }

    private async Task OpenModal(VerticalUserMaster? user)
    {
        if (user == null)
        {
            isAddingNew = true;
            modalTitle = "Add New User";
            userInModal = new VerticalUserMaster();
        }
        else
        {
            isAddingNew = false;
            modalTitle = $"Edit User ({user.UserName})";
            userInModal = await DbService.GetUserBySqNoAsync(user.SqNo);
        }
        isModalVisible = true;
    }

    private void CloseModal() => isModalVisible = false;

    private async Task HandleSubmit()
    {
        if (userInModal.UserType == "Admin")
        {
            userInModal.VerticalId = null;
        }
        else if (string.IsNullOrEmpty(userInModal.VerticalId))
        {
            await JSRuntime.InvokeVoidAsync("alert", "Please select a vertical for a 'Vertical' type user.");
            return;
        }

        try
        {
            if (isAddingNew)
            {
                await DbService.AddUserAsync(userInModal, currentUserId);
                await JSRuntime.InvokeVoidAsync("alert", "User added successfully!");
            }
            else
            {
                await DbService.UpdateUserAsync(userInModal, currentUserId);
                await JSRuntime.InvokeVoidAsync("alert", "User updated successfully!");
            }
            CloseModal();
            await Task.WhenAll(
                LoadUsers(isAddingNew ? 1 : currentPage),
                LoadDropdownData()
            );
        }
        catch (Exception ex)
        {
            await JSRuntime.InvokeVoidAsync("alert", $"Error: {ex.Message}");
        }
    }

    private async Task TriggerSubmit()
    {
        if (modalForm?.EditContext != null && modalForm.EditContext.Validate())
        {
            await HandleSubmit();
        }
    }

    private async Task ToggleStatusAsync(VerticalUserMaster user)
    {
        var newStatus = user.Status == "Active" ? "Inactive" : "Active";
        if (await JSRuntime.InvokeAsync<bool>("confirm", $"Change status of '{user.UserName}' to {newStatus}?"))
        {
            try
            {
                await DbService.SetUserStatusAsync(user.SqNo, newStatus, currentUserId);
                await Task.WhenAll(
                    LoadUsers(currentPage),
                    LoadDropdownData()
                );
            }
            catch (Exception ex)
            {
                await JSRuntime.InvokeVoidAsync("alert", $"Error: {ex.Message}");
            }
        }
    }
}