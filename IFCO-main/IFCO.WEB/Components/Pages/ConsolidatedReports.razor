@page "/consolidated-reports"
@using IFCO.WEB.Models
@using IFCO.WEB.Services
@using System.IO
@using System.Security.Claims
@using IFCO.WEB.Helpers
@inject OracleService DbService
@inject IJSRuntime JSRuntime
@rendermode InteractiveServer
@attribute [Authorize(Roles = "Admin, Checker")]

<PageTitle>Consolidated Reports</PageTitle>

<div class="container-fluid">
    <div class="row">
        <div class="col-12">
            <h3 class="mb-4">Consolidated Quarter Reports</h3>
        </div>
    </div>

    @* --- UPLOAD SECTION (Visible to CHECKER Only) --- *@
    @if (isChecker)
    {
        <div class="card shadow-sm mb-4">
            <div class="card-header bg-success text-white">
                <h5 class="mb-0"><i class="bi bi-cloud-upload me-2"></i>Upload New Report</h5>
            </div>
            <div class="card-body">
                <EditForm Model="uploadModel" OnValidSubmit="HandleUpload">
                    <DataAnnotationsValidator />

                    <div class="row align-items-end">
                        <div class="col-md-3">
                            <label class="form-label">Financial Year</label>
                            @* Using a simple input, or you could generate a dropdown of years *@
                            <InputSelect @bind-Value="uploadModel.FinancialYear" class="form-select">
                                <option value="">-- Select FY --</option>
                                @foreach (var year in financialYears)
                                {
                                    <option value="@year">@year</option>
                                }
                            </InputSelect>
                        </div>

                        <div class="col-md-2">
                            <label class="form-label">Quarter</label>
                            <InputSelect @bind-Value="uploadModel.Quarter" class="form-select">
                                <option value="0">Select</option>
                                <option value="1">Q1</option>
                                <option value="2">Q2</option>
                                <option value="3">Q3</option>
                                <option value="4">Q4</option>
                            </InputSelect>
                        </div>

                        <div class="col-md-5">
                            <label class="form-label">Select File (PDF, Excel, Doc, PPT, Img)</label>
                            <InputFile OnChange="OnInputFileChange" class="form-control" accept="@FileUploadValidator.AcceptAttributeValue" />
                            <small class="text-muted">Max 5MB. Allowed: JPG, PNG, PDF, XLSX, DOCX, PPTX.</small>
                        </div>

                        <div class="col-md-2">
                            <button type="submit" class="btn btn-primary w-100" disabled="@isUploading">
                                @if (isUploading)
                                {
                                    <span class="spinner-border spinner-border-sm" role="status" aria-hidden="true"></span>
                                }
                                else
                                {
                                    <span>Submit Report</span>
                                }
                            </button>
                        </div>
                    </div>
                </EditForm>
            </div>
        </div>
    }

    @* --- VIEW SECTION (Visible to ALL Authorized Users) --- *@
    <div class="card shadow-sm">
        <div class="card-header bg-primary text-white">
            <h5 class="mb-0"><i class="bi bi-list-check me-2"></i>Existing Reports</h5>
        </div>
        <div class="card-body">
            @if (reports == null)
            {
                <p>Loading reports...</p>
            }
            else if (reports.Count == 0)
            {
                <p class="text-muted">No reports uploaded yet.</p>
            }
            else
            {
                <div class="table-responsive">
                    <table class="table table-bordered table-hover align-middle">
                        <thead class="table-light">
                            <tr>
                                <th>Financial Year</th>
                                <th>Quarter 1</th>
                                <th>Quarter 2</th>
                                <th>Quarter 3</th>
                                <th>Quarter 4</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var item in reports)
                            {
                                <tr>
                                    <td class="fw-bold">@item.FinancialYear</td>
                                    <td>@RenderFileCell(item.FinancialYear, 1, item.Q1File)</td>
                                    <td>@RenderFileCell(item.FinancialYear, 2, item.Q2File)</td>
                                    <td>@RenderFileCell(item.FinancialYear, 3, item.Q3File)</td>
                                    <td>@RenderFileCell(item.FinancialYear, 4, item.Q4File)</td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            }
        </div>
    </div>
</div>

@code {
    [CascadingParameter]
    private Task<AuthenticationState> AuthenticationStateTask { get; set; }

    // State
    private bool isChecker = false;
    private bool isUploading = false;
    private List<QuarterReportSummary>? reports;
    private List<string> financialYears = new();

    // Upload Model
    private UploadViewModel uploadModel = new();
    private IBrowserFile? selectedFile;
    // File size/type limits now come from FileUploadValidator (shared across every upload point in the app).

    // Helper Class for Form
    public class UploadViewModel
    {
        public string FinancialYear { get; set; } = "";
        public int Quarter { get; set; }
    }

    protected override async Task OnInitializedAsync()
    {
        // 1. Check Roles
        var authState = await AuthenticationStateTask;
        var user = authState.User;

        if (user.Identity != null && user.Identity.IsAuthenticated)
        {
            isChecker = user.IsInRole("Checker");
        }

        // 2. Generate Financial Years (e.g., last 3 years + next year)
        int currentYear = DateTime.Now.Year;
        for (int i = -2; i <= 1; i++)
        {
            financialYears.Add($"{currentYear + i}-{currentYear + i + 1}");
        }

        // 3. Load Data
        await LoadReports();
    }

    private async Task LoadReports()
    {
        // Fetching page 1, size 100 for now (Consolidated view)
        var result = await DbService.GetQuarterReportsSummaryAsync(1, 100);
        reports = result.Reports;
    }

    // --- RENDER HELPER ---
    private RenderFragment RenderFileCell(string fy, int q, string fileName)
    {
        if (fileName == "No file present")
        {
            return @<span class="text-muted small">Pending</span>;
        }
        else
        {
            // Requirement 6: Make clickable
            return @<button class="btn btn-link btn-sm text-decoration-none" @onclick="() => DownloadFile(fy, q)">
        <i class="bi bi-file-earmark-arrow-down"></i> @fileName
    </button>;
        }
    }

    // --- UPLOAD LOGIC ---
    private void OnInputFileChange(InputFileChangeEventArgs e)
    {
        selectedFile = e.File;
    }

    private async Task HandleUpload()
    {
        // Validations
        if (string.IsNullOrEmpty(uploadModel.FinancialYear))
        {
            await JSRuntime.InvokeVoidAsync("alert", "Please select Financial Year."); return;
        }
        if (uploadModel.Quarter < 1 || uploadModel.Quarter > 4)
        {
            await JSRuntime.InvokeVoidAsync("alert", "Please select a valid Quarter."); return;
        }
        if (selectedFile == null)
        {
            await JSRuntime.InvokeVoidAsync("alert", "Please select a file."); return;
        }

        // Extension + size validation (shared across every upload point in the app)
        if (!FileUploadValidator.TryValidate(selectedFile.Name, selectedFile.Size, out var validationError))
        {
            await JSRuntime.InvokeVoidAsync("alert", validationError);
            return;
        }

        try
        {
            isUploading = true;

            // Convert file to byte array
            using var stream = selectedFile.OpenReadStream(FileUploadValidator.MaxFileSizeBytes);
            using var ms = new MemoryStream();
            await stream.CopyToAsync(ms);
            byte[] fileData = ms.ToArray();

            // Get Current User for "Uploaded By"
            var authState = await AuthenticationStateTask;
            string uploadedBy = authState.User.Identity?.Name ?? "Unknown";

            // Call Service
            await DbService.UploadQuarterReportAsync(
                uploadModel.FinancialYear,
                uploadModel.Quarter,
                selectedFile.Name,
                fileData,
                uploadedBy
            );

            await JSRuntime.InvokeVoidAsync("alert", "Report uploaded successfully!");

            // Reset form and reload list
            selectedFile = null;
            uploadModel = new UploadViewModel(); // Clear selection
            await LoadReports();
        }
        catch (Exception ex)
        {
            if (ex.Message.Contains("ORA-200006") || ex.Message.Contains("already been uploaded"))
            {
                await JSRuntime.InvokeVoidAsync("alert", "⚠️ Action Denied: A report for this Financial Year and Quarter has already been uploaded. You cannot overwrite an existing report.");
            }
            else
            {
                // Show generic error for other issues
                await JSRuntime.InvokeVoidAsync("alert", $"Upload Failed: {ex.Message}");
            }
        }
        finally
        {
            isUploading = false;
        }
    }

    // --- DOWNLOAD LOGIC ---
    private async Task DownloadFile(string fy, int quarter)
    {
        try
        {
            var fileResult = await DbService.GetQuarterFileAsync(fy, quarter);

            using var stream = new MemoryStream(fileResult.FileData);
            using var streamRef = new DotNetStreamReference(stream);

            await JSRuntime.InvokeVoidAsync("downloadFileFromStream", fileResult.FileName, streamRef);
        }
        catch (Exception ex)
        {
            await JSRuntime.InvokeVoidAsync("alert", $"Download Error: {ex.Message}");
        }
    }
}