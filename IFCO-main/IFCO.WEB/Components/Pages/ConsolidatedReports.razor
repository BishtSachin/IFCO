@page "/consolidated-reports"
@using IFCO.WEB.Models
@using IFCO.WEB.Services
@using System.IO
@inject OracleService DbService
@inject IJSRuntime JSRuntime
@rendermode InteractiveServer
@attribute [Authorize(Roles = "Admin, Checker")]

<PageTitle>Consolidated Reports</PageTitle>

<div class="container-fluid">
    <div class="row">
        <div class="col-12">
            <h3 class="mb-4">Consolidated Quarter Reports</h3>
            <p class="text-muted">Reports are now filed as part of Close Quarter (Admin). This page is for viewing and downloading previously filed reports.</p>
        </div>
    </div>

    @* NEW: Direct upload here is retired - filing a report is now done as
       part of Close Quarter (Components/Pages/CloseQuarter.razor), which
       calls the same UploadQuarterReportAsync used here. This page is now
       view/download only for whoever already has access (Admin, Checker). *@

    @* --- VIEW SECTION (Visible to ALL Authorized Users) --- *@
    <div class="card shadow-sm">
        <div class="card-header bg-primary text-white">
            <h5 class="mb-0"><i class="bi bi-list-check me-2"></i>Existing Reports</h5>
        </div>
        <div class="card-body">
            @if (reports == null)
            {
                <p>Loading reports...</p>
            }
            else if (reports.Count == 0)
            {
                <p class="text-muted">No reports uploaded yet.</p>
            }
            else
            {
                <div class="table-responsive">
                    <table class="table table-bordered table-hover align-middle">
                        <thead class="table-light">
                            <tr>
                                <th>Financial Year</th>
                                <th>Quarter 1</th>
                                <th>Quarter 2</th>
                                <th>Quarter 3</th>
                                <th>Quarter 4</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var item in reports)
                            {
                                <tr>
                                    <td class="fw-bold">@item.FinancialYear</td>
                                    <td>@RenderFileCell(item.FinancialYear, 1, item.Q1File)</td>
                                    <td>@RenderFileCell(item.FinancialYear, 2, item.Q2File)</td>
                                    <td>@RenderFileCell(item.FinancialYear, 3, item.Q3File)</td>
                                    <td>@RenderFileCell(item.FinancialYear, 4, item.Q4File)</td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            }
        </div>
    </div>
</div>

@code {
    // State
    private List<QuarterReportSummary>? reports;

    protected override async Task OnInitializedAsync()
    {
        await LoadReports();
    }

    private async Task LoadReports()
    {
        // Fetching page 1, size 100 for now (Consolidated view)
        var result = await DbService.GetQuarterReportsSummaryAsync(1, 100);
        reports = result.Reports;
    }

    // --- RENDER HELPER ---
    private RenderFragment RenderFileCell(string fy, int q, string fileName)
    {
        if (fileName == "No file present")
        {
            return @<span class="text-muted small">Pending</span>;
        }
        else
        {
            // Requirement 6: Make clickable
            return @<button class="btn btn-link btn-sm text-decoration-none" @onclick="() => DownloadFile(fy, q)">
        <i class="bi bi-file-earmark-arrow-down"></i> @fileName
    </button>;
        }
    }

    // --- DOWNLOAD LOGIC ---
    private async Task DownloadFile(string fy, int quarter)
    {
        try
        {
            var fileResult = await DbService.GetQuarterFileAsync(fy, quarter);

            using var stream = new MemoryStream(fileResult.FileData);
            using var streamRef = new DotNetStreamReference(stream);

            await JSRuntime.InvokeVoidAsync("downloadFileFromStream", fileResult.FileName, streamRef);
        }
        catch (Exception ex)
        {
            await JSRuntime.InvokeVoidAsync("alert", $"Download Error: {ex.Message}");
        }
    }
}