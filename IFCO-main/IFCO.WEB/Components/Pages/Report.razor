@page "/reports"
@using IFCO.WEB.Models
@using IFCO.WEB.Services
@using System.Security.Claims
@inject OracleService DbService
@inject IJSRuntime JSRuntime
@rendermode InteractiveServer
@attribute [Authorize(Roles = "Admin, Vertical, Checker")]

<PageTitle>Generate Reports</PageTitle>

<div class="card shadow-sm">
    <div class="card-header bg-primary text-white">
        <h5 class="mb-0"><i class="bi bi-file-earmark-spreadsheet me-2"></i>Generate Reports</h5>
    </div>
    <div class="card-body">

        @* 1. Main Selection Options *@
        <div class="mb-4">
            <label class="form-label fw-bold">Select Report Type:</label>
            <div class="d-flex gap-4">

                @* HIDE Vertical Wise option if the user is a Vertical User *@
                @if (!isVerticalUser)
                {
                    <div class="form-check">
                        <input class="form-check-input" type="radio" name="reportType" id="optVertical"
                               checked="@(selectedReportType == "Vertical")"
                               @onchange="@(() => OnReportTypeChanged("Vertical"))">
                        <label class="form-check-label" for="optVertical">Vertical Wise</label>
                    </div>
                }

                @* ALWAYS Show RCM Wise option *@
                <div class="form-check">
                    <input class="form-check-input" type="radio" name="reportType" id="optRcm"
                           checked="@(selectedReportType == "RCM")"
                           @onchange="@(() => OnReportTypeChanged("RCM"))">
                    <label class="form-check-label" for="optRcm">RCM Wise</label>
                </div>

                @* Consolidated: everything in one worksheet (no dropdown needed) *@
                <div class="form-check">
                    <input class="form-check-input" type="radio" name="reportType" id="optConsolidated"
                           checked="@(selectedReportType == "Consolidated")"
                           @onchange="@(() => OnReportTypeChanged("Consolidated"))">
                    <label class="form-check-label" for="optConsolidated">Consolidated Report</label>
                </div>

            </div>
        </div>

        <hr />

        @* 2. Dynamic Inputs based on Selection *@
        <div class="row">

            @if (selectedReportType == "Vertical")
            {
                <div class="col-md-6">
                    <label class="form-label">Select Vertical:</label>
                    <SearchableSelect TItem="VerticalDropdownItem"
                                      TValue="string"
                                      Items="verticalsList"
                                      ValueSelector="@(v => v.VerticalId)"
                                      TextSelector="@(v => v.VerticalName)"
                                      SelectedValue="selectedVerticalId"
                                      SelectedValueChanged="@((string v) => selectedVerticalId = v)"
                                      IsPinned="@(v => v.VerticalId == AllValue)"
                                      Placeholder="-- Select Vertical --" />
                </div>
            }
            else if (selectedReportType == "RCM")
            {
                <div class="col-md-6">
                    <label class="form-label">Select RCM:</label>
                    <SearchableSelect TItem="RcmDropdownItem"
                                      TValue="string"
                                      Items="rcmList"
                                      ValueSelector="@(r => r.RcmSqNo)"
                                      TextSelector="@(r => r.RcmName)"
                                      SelectedValue="selectedRcmId"
                                      SelectedValueChanged="@((string v) => selectedRcmId = v)"
                                      IsPinned="@(r => r.RcmSqNo == AllValue)"
                                      Placeholder="-- Select RCM --" />
                </div>
            }
            else if (selectedReportType == "Consolidated")
            {
                <div class="col-md-8">
                    <div class="alert alert-info mb-0" role="alert">
                        <i class="bi bi-info-circle me-2"></i>
                        One Excel worksheet with the current quarter's points for
                        @(isVerticalUser ? "all of your RCMs" : "all RCMs and verticals"),
                        with the RCM and Vertical names in each row.
                    </div>
                </div>
            }
        </div>

        @* 3. Download Button *@
        <div class="mt-4">
            <button class="btn btn-success" @onclick="DownloadReport" disabled="@isDownloading">
                @if (isDownloading)
                {
                    <span class="spinner-border spinner-border-sm me-2" role="status" aria-hidden="true"></span>
                    <span>Generating...</span>
                }
                else
                {
                    <i class="bi bi-download me-2"></i> <span>Download Excel Report</span>
                }
            </button>
        </div>

    </div>
</div>

@code {
    // Auth State
    [CascadingParameter]
    private Task<AuthenticationState> AuthenticationStateTask { get; set; }

    private bool isVerticalUser = false;

    // Vertical users (non-admin) only get points from the verification stage onwards,
    // the same statuses they can see on the RCM Points page. Everyone else: no limit.
    private static readonly string[] VerticalReportStatuses =
        { "Verified", "Management Submitted", "Admin Submitted", "Admin Recommended" };
    private IReadOnlyCollection<string>? ReportStatusLimit => isVerticalUser ? VerticalReportStatuses : null;
    private string? userVerticalIdClaim;

    // Sentinel value for the pinned "All ..." dropdown entries. Never a real ID.
    private const string AllValue = "__ALL__";

    // State Variables
    private string selectedReportType = "Vertical";
    private string? selectedVerticalId;
    private string? selectedRcmId;
    private bool isDownloading = false;

    // Dropdown Data
    private List<VerticalDropdownItem>? verticalsList;
    private List<RcmDropdownItem>? rcmList;

    protected override async Task OnInitializedAsync()
    {
        // 1. Identify User Role and Vertical ID
        var authState = await AuthenticationStateTask;
        var user = authState.User;

        if (user.Identity != null && user.Identity.IsAuthenticated)
        {
            // Check based on logic in AuthController.cs
            var roleClaim = user.FindFirst(ClaimTypes.Role)?.Value;
            var loginTypeClaim = user.FindFirst("LoginType")?.Value;
            userVerticalIdClaim = user.FindFirst("VerticalId")?.Value;

            if (loginTypeClaim == "Vertical" && roleClaim == "Vertical")
            {
                isVerticalUser = true;
                selectedReportType = "RCM"; // Force RCM mode
            }
        }

        // 2. Load Data based on Role
        if (isVerticalUser)
        {
            // Vertical User: Only load RCMs mapped to their vertical
            if (!string.IsNullOrEmpty(userVerticalIdClaim))
            {
                rcmList = WithAllRcms(await DbService.GetActiveRcmsByVerticalAsync(userVerticalIdClaim));
            }
            else
            {
                // Safety check if claim is missing
                await JSRuntime.InvokeVoidAsync("alert", "Error: Vertical ID not found for user.");
            }
        }
        else
        {
            // Admin User: Load everything normally
            verticalsList = WithAllVerticals(await DbService.GetActiveVerticalsAsync());
            rcmList = WithAllRcms(await DbService.GetActiveRcmsAsyncForReport());
        }
    }

    // Prepend the "All" entry only when there is something to be "all" of.
    private static List<VerticalDropdownItem> WithAllVerticals(List<VerticalDropdownItem> items)
    {
        if (items.Count > 0)
            items.Insert(0, new VerticalDropdownItem { VerticalId = AllValue, VerticalName = "All Verticals" });
        return items;
    }

    private static List<RcmDropdownItem> WithAllRcms(List<RcmDropdownItem> items)
    {
        if (items.Count > 0)
            items.Insert(0, new RcmDropdownItem { RcmSqNo = AllValue, RcmName = "All RCMs" });
        return items;
    }

    private void OnReportTypeChanged(string newType)
    {
        selectedReportType = newType;

        // Reset inputs
        selectedVerticalId = null;
        selectedRcmId = null;
    }

    private async Task DownloadReport()
    {
        // Validation
        if (selectedReportType == "Vertical" && string.IsNullOrEmpty(selectedVerticalId))
        {
            await JSRuntime.InvokeVoidAsync("alert", "Please select a Vertical.");
            return;
        }
        if (selectedReportType == "RCM" && string.IsNullOrEmpty(selectedRcmId))
        {
            await JSRuntime.InvokeVoidAsync("alert", "Please select an RCM.");
            return;
        }

        // Consolidated = every RCM this user is allowed to see, in one worksheet.
        // Built from the same list that feeds the RCM dropdown, so a Vertical user
        // only ever gets the RCMs mapped to their own vertical.
        string? consolidatedRcmIds = null;
        if (selectedReportType == "Consolidated")
        {
            var ids = (rcmList ?? new()).Where(r => r.RcmSqNo != AllValue).Select(r => r.RcmSqNo).ToList();
            if (ids.Count == 0)
            {
                await JSRuntime.InvokeVoidAsync("alert", "There are no RCMs available to include in the report.");
                return;
            }
            consolidatedRcmIds = string.Join(",", ids);
        }

        try
        {
            isDownloading = true;

            byte[] fileBytes;
            bool isAll = selectedReportType == "Vertical"
                ? selectedVerticalId == AllValue
                : selectedReportType == "RCM" && selectedRcmId == AllValue;

            if (consolidatedRcmIds != null)
            {
                // get_report_by_rcm_list already accepts a comma-separated list of RCM numbers
                fileBytes = await DbService.GenerateReportExcelAsync("RCM", null, consolidatedRcmIds, ReportStatusLimit);
            }
            else if (isAll)
            {
                // One workbook, one sheet per vertical / RCM. The target list
                // is exactly what this user's dropdown already offers, so
                // "All" never exposes more than they could pick one by one.
                var targets = selectedReportType == "Vertical"
                    ? (verticalsList ?? new()).Where(v => v.VerticalId != AllValue)
                          .Select(v => (v.VerticalId, v.VerticalName)).ToList()
                    : (rcmList ?? new()).Where(r => r.RcmSqNo != AllValue)
                          .Select(r => (r.RcmSqNo, r.RcmName)).ToList();

                fileBytes = await DbService.GenerateAllReportExcelAsync(selectedReportType, targets, ReportStatusLimit);
            }
            else
            {
                fileBytes = await DbService.GenerateReportExcelAsync(
                    selectedReportType,
                    selectedVerticalId,
                    selectedRcmId,
                    ReportStatusLimit
                );
            }

            using var stream = new MemoryStream(fileBytes);
            using var streamRef = new DotNetStreamReference(stream);

            string fileName = $"Report_{(isAll ? "All" : "")}{selectedReportType}_{DateTime.Now:yyyyMMddHHmm}.xlsx";

            await JSRuntime.InvokeVoidAsync("downloadFileFromStream", fileName, streamRef);
        }
        catch (Exception ex)
        {
            await JSRuntime.InvokeVoidAsync("alert", $"Error generating report: {ex.Message}");
        }
        finally
        {
            isDownloading = false;
        }
    }
}