@* File: Shared/Modal.razor *@

@if (IsOpen)
{
    <div class="modal-backdrop fade show"></div>
    <div class="modal fade show" tabindex="-1" style="display: block;" role="dialog">
        @* MODIFIED: Swapped hardcoded 'modal-lg' for a dynamic CSS class *@
        <div class="modal-dialog @ModalSizeCssClass" role="document">
            <div class="modal-content">
                <div class="modal-header">
                    <h5 class="modal-title">@Title</h5>
                    <button type="button" class="btn-close" @onclick="Close"></button>
                </div>
                <div class="modal-body">
                    @Body
                </div>
                @if (Footer != null)
                {
                    <div class="modal-footer">
                        @Footer
                    </div>
                }
            </div>
        </div>
    </div>
}

@code {
    // --- NEW: Enum to define possible modal sizes ---
    public enum ModalSize
    {
        Default,
        Small,
        Large,
        ExtraLarge
    }

    // --- NEW: Parameter to accept a size value from parent components ---
    [Parameter]
    public ModalSize Size { get; set; } = ModalSize.Large; // Default to Large

    // --- NEW: Computed property to generate the correct Bootstrap CSS class ---
    private string ModalSizeCssClass => Size switch
    {
        ModalSize.Small => "modal-sm",
        ModalSize.Large => "modal-lg",
        ModalSize.ExtraLarge => "modal-xl",
        _ => ""
    };

    // --- Existing Parameters ---
    [Parameter]
    public bool IsOpen { get; set; }

    [Parameter]
    public EventCallback<bool> IsOpenChanged { get; set; }

    [Parameter]
    public string Title { get; set; }

    [Parameter]
    public RenderFragment Body { get; set; }

    [Parameter]
    public RenderFragment Footer { get; set; }

    private Task Close()
    {
        IsOpen = false;
        return IsOpenChanged.InvokeAsync(IsOpen);
    }
}