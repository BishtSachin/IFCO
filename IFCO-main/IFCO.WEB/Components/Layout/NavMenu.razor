@using System.Security.Claims

<div class="nav-scrollable">
    <nav class="flex-column">
        <AuthorizeView>
            <Authorized>
                @{
                    // Define helper variables to make the logic cleaner
                    var isVertical = context.User.FindFirstValue("LoginType") == "Vertical";
                    var isAdmin = context.User.IsInRole("Admin");
                    var isConsultant = context.User.FindFirstValue("LoginType") == "Consultant";
                    var isVerticalAdmin = isVertical && isAdmin;
                }

                @* 1. Home: Accessible by all logged-in users *@
                <div class="nav-item px-3">
                    <NavLink class="nav-link" href="home" Match="NavLinkMatch.All">
                        <span class="bi bi-house-door" aria-hidden="true"></span> <span class="nav-text">Home</span>
                    </NavLink>
                </div>

                @* 2-5. Masters: Accessible by 'Vertical' & 'Admin' users ONLY *@
                @if (isVerticalAdmin)
                {
                    <div class="nav-item px-3">
                        <NavLink class="nav-link" href="verticals">
                            <span class="bi bi-diagram-3" aria-hidden="true"></span> <span class="nav-text">Vertical Master</span>
                        </NavLink>
                    </div>
                    <div class="nav-item px-3">
                        <NavLink class="nav-link" href="consultants">
                            <span class="bi bi-person-badge" aria-hidden="true"></span> <span class="nav-text">Consultant Master</span>
                        </NavLink>
                    </div>
                    <div class="nav-item px-3">
                        <NavLink class="nav-link" href="rcms">
                            <span class="bi bi-card-checklist" aria-hidden="true"></span> <span class="nav-text">RCM Master</span>
                        </NavLink>
                    </div>
                    <div class="nav-item px-3">
                        <NavLink class="nav-link" href="users">
                            <span class="bi bi-people" aria-hidden="true"></span> <span class="nav-text">User Master</span>
                        </NavLink>
                    </div>
                }

                @* 6. RCM Points: Accessible by 'Vertical'/'Admin' OR 'Consultant' *@
                @if (isVerticalAdmin || isConsultant || isVertical)
                {
                    <div class="nav-item px-3">
                        <NavLink class="nav-link" href="rcm-points">
                            <span class="bi bi-list-task" aria-hidden="true"></span> <span class="nav-text">RCM Points</span>
                        </NavLink>
                    </div>
                    <div class="nav-item px-3">
                        <NavLink class="nav-link" href="reports">
                            <span class="bi bi-file-earmark-bar-graph" aria-hidden="true"></span> <span class="nav-text">Report Generation</span>
                        </NavLink>
                    </div>
                }

                @if (isVerticalAdmin || isConsultant)
                {
                    <div class="nav-item px-3">
                        <NavLink class="nav-link" href="consolidated-reports">
                            <span class="bi bi-file-earmark-arrow-up" aria-hidden="true"></span> <span class="nav-text">Quaterly Report Submission</span>
                        </NavLink>
                    </div>
                }
            </Authorized>
        </AuthorizeView>
    </nav>
</div>

@code {
    [Parameter]
    public bool IsCollapsed { get; set; }
}